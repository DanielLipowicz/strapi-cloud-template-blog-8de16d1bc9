HOST=0.0.0.0
PORT=1337

# Comma-separated keys (generate unique values for production)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Shared read-only token used by the SimplicityVibe backend. The deployment
# seed provisions this exact token in Strapi without printing it to logs.
STRAPI_API_TOKEN=changeMe

# Enables the two versioned demo articles. Keep false for editorial production.
STRAPI_DEMO_CONTENT_ENABLED=true

# Optional: postgres | mysql | sqlite (default)
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
# DATABASE_URL=postgres://user:pass@localhost:5432/strapi

# BL-003b: POST article lifecycle events to SimplicityVibe backend (read model / cache invalidation)
# KNOWLEDGE_HUB_WEBHOOK_URL=http://localhost:8080/api/v1/internal/knowledge/strapi-webhook
# KNOWLEDGE_HUB_WEBHOOK_SECRET=

# Strapi Cloud (if used)
# STRAPI_ADMIN_BACKEND_URL=
